{
	"name": "obsidian-quotable",
	"version": "0.3.1",
	"description": "Turn selected text into a shareable image.",
	"main": "main.js",
	"private": true,
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"typecheck": "tsc -noEmit -skipLibCheck",
		"test:capture": "esbuild tools/capture-tests.ts --bundle --platform=node --format=esm --outfile=dev-harness/capture-tests.mjs --log-level=error && node dev-harness/capture-tests.mjs",
		"test:zip": "esbuild tools/zip-tests.ts --bundle --platform=node --format=esm --outfile=dev-harness/zip-tests.mjs --log-level=error && node dev-harness/zip-tests.mjs",
		"test": "npm run test:capture && npm run test:zip"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"quote",
		"share",
		"image"
	],
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^20.11.0",
		"esbuild": "^0.20.0",
		"obsidian": "latest",
		"tslib": "^2.6.2",
		"typescript": "^5.3.3"
	},
	"allowScripts": {
		"esbuild@0.20.2": true
	}
}
